# Copy this to .env and fill in your values
# Get Groq API key free at: https://console.groq.com (no credit card)

GROQ_API_KEY=your_groq_api_key_here

# Optional fallback: OpenRouter free tier
# OPENROUTER_API_KEY=your_openrouter_key_here

# Model to use (free on Groq)
GROQ_MODEL=llama-3.3-70b-versatile

# Local ChromaDB path (no setup needed, runs in-process)
CHROMA_DB_PATH=./data/chroma_db

# Lab settings
LAB_NAME=RAG Poisoning Demo Lab
DEBUG=false
